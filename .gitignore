# =========================
# Python bytecode / caches
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
.venv/
venv/
ENV/
env/

# =========================
# Packaging / build artifacts
# =========================
*.egg-info/
.eggs/
build/
dist/
wheelhouse/
pip-wheel-metadata/

# =========================
# Test / type-check / tool caches
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# IDE / OS
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# Windows reserved filenames (created when `> nul` is used in Git Bash
# instead of `> /dev/null`; Git Bash treats "nul" as a literal filename)
nul
nul.*

# =========================
# Project outputs (do not version)
# =========================
processed_data/
plots/
reports/
tmp/
temp/
*.log
*.bak

# =========================
# Generated notebook outputs
# =========================
notebooks/**/*_computed.txt
notebooks/**/*_executed.ipynb
notebooks/**/*.png

# =========================
# Executed notebooks (large, regenerated on demand)
# =========================
notebooks/**/executed_*.ipynb

# =========================
# Temp plots from interactive analysis
# =========================
*.png
!docs/*.png


# =========================
# Data (raw measurement data should live outside repo)
# =========================
data/raw/
data/large/
*.bin
# If you want to keep small example .bin files under version control, remove the line above.

# =========================
# Golden standards (local validation data, too large for git)
# =========================
golden_standards/

# =========================
# Optional: local scratch notebooks
# =========================
notebooks/_scratch/

# =========================
# Measurement data (raw acquisition, too large for git)
# =========================
measurements/

# =========================
# Local analysis output (notebook exports, plots, etc.)
# =========================
output/

# =========================
# Presentation template & generator
# =========================
presentation_template/

# =========================
# Generated presentations (PPTX, regenerated from notebooks)
# =========================
notebooks/**/*.pptx

# =========================
# Old reports / documents (large PDFs, not for version control)
# =========================
notebooks/**/old_reports_and_documents/

# =========================
# Archived (superseded) notebooks
# =========================
notebooks/**/_archive/

# =========================
# Generated reports (PDFs regenerated from notebooks/scripts)
# =========================
notebooks/**/*.pdf

# =========================
# Large data files (HDF5, etc.)
# =========================
*.h5

# =========================
# rca-analyze default output folder (demo data + CSVs)
# =========================
rca_output/

# SM18 parity notebook: ~285k points per trace make the SVG copies huge
notebooks/SM18/**/figures/*.svg
notebooks/SM18/**/figures/.editable/
